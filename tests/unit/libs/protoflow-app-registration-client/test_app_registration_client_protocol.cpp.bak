#include <protoflow/app_registration_client/app_registration_client.hpp>
#include <protoflow/app_registration_protocol.hpp>
#include <protoflow/rpc_service/messages.hpp>
#include <protoflow/rpc/protocol.hpp>
#include <gtest/gtest.h>
#include <gmock/gmock.h>
#include <cstring>

using namespace protoflow::app_registration_client;
using namespace protoflow::app_registration_protocol;
using namespace protoflow::rpc_service;

// Test configuration helper
Config make_test_config_protocol(const std::string& app_name = "protocol_test_app") {
    return Config{
        .app_name = app_name,
        .version = 1,
        .endpoints = {"http://localhost:8080", "ws://localhost:8081"},
        .server_address = "127.0.0.1",
        .server_port = 9000,
        .heartbeat_interval = std::chrono::seconds(5),
        .connection_timeout = std::chrono::milliseconds(1000),
        .read_timeout = std::chrono::milliseconds(500),
        .write_timeout = std::chrono::milliseconds(500)
    };
}

class AppRegistrationClientProtocolTest : public ::testing::Test {
protected:
    void SetUp() override {
        config = make_test_config_protocol();
    }

    Config config;
};

TEST_F(AppRegistrationClientProtocolTest, HandleRpcConnectedMessage) {
    AppRegistrationClient client(config);
    
    // Start connection
    client.start();
    EXPECT_EQ(client.current_state(), State::Connecting);
    
    // Simulate RPC connection success
    RpcConnected msg{.connection_id = 123};
    client.handle(protoflow::service::Message{msg});
    
    // Should transition to Registering state
    EXPECT_EQ(client.current_state(), State::Registering);
}

TEST_F(AppRegistrationClientProtocolTest, HandleRpcConnectionFailedFromConnecting) {
    AppRegistrationClient client(config);
    
    client.start();
    EXPECT_EQ(client.current_state(), State::Connecting);
    
    // Simulate connection failure
    RpcConnectionFailed msg{.error = "Connection refused"};
    client.handle(protoflow::service::Message{msg});
    
    // Should transition to Disconnected (via Disconnected event)
    EXPECT_EQ(client.current_state(), State::Disconnected);
}

TEST_F(AppRegistrationClientProtocolTest, HandleRpcDisconnectedMessage) {
    AppRegistrationClient client(config);
    
    // Get to Registering state
    client.start();
    RpcConnected conn_msg{.connection_id = 456};
    client.handle(protoflow::service::Message{conn_msg});
    
    EXPECT_EQ(client.current_state(), State::Registering);
    
    // Simulate disconnection
    RpcDisconnected disc_msg{.connection_id = 456};
    client.handle(protoflow::service::Message{disc_msg});
    
    // Should transition to Reconnecting
    EXPECT_EQ(client.current_state(), State::Reconnecting);
}

TEST_F(AppRegistrationClientProtocolTest, IgnoreDisconnectFromWrongConnection) {
    AppRegistrationClient client(config);
    
    // Get to Registering state with connection_id 100
    client.start();
    RpcConnected conn_msg{.connection_id = 100};
    client.handle(protoflow::service::Message{conn_msg});
    
    State before_disconnect = client.current_state();
    
    // Simulate disconnection from different connection
    RpcDisconnected disc_msg{.connection_id = 999};
    client.handle(protoflow::service::Message{disc_msg});
    
    // Should ignore and stay in same state
    EXPECT_EQ(client.current_state(), before_disconnect);
}

TEST_F(AppRegistrationClientProtocolTest, HandleHelloAckMessage) {
    AppRegistrationClient client(config);
    
    // Get to Registering state
    client.start();
    RpcConnected conn_msg{.connection_id = 200};
    client.handle(protoflow::service::Message{conn_msg});
    
    EXPECT_EQ(client.current_state(), State::Registering);
    
    // Create HELLO_ACK response
    hello_ack ack{.version = 1};
    
    auto header = protoflow::rpc::make_header(
        static_cast<uint16_t>(command::hello_ack),
        sizeof(ack)
    );
    
    std::vector<std::byte> data;
    data.resize(sizeof(header) + sizeof(ack));
    std::memcpy(data.data(), &header, sizeof(header));
    std::memcpy(data.data() + sizeof(header), &ack, sizeof(ack));
    
    RpcReceived recv_msg{
        .connection_id = 200,
        .data = std::move(data)
    };
    
    client.handle(protoflow::service::Message{std::move(recv_msg)});
    
    // Should stay in Registering state (handshake complete triggers registration send)
    EXPECT_EQ(client.current_state(), State::Registering);
}

TEST_F(AppRegistrationClientProtocolTest, HandleRegisterAckMessage) {
    AppRegistrationClient client(config);
    
    // Get to Registering state
    client.start();
    RpcConnected conn_msg{.connection_id = 300};
    client.handle(protoflow::service::Message{conn_msg});
    
    // Create REGISTER_ACK response
    register_ack ack{
        .app_id = 42,
        .status = 0  // Success
    };
    
    auto header = protoflow::rpc::make_header(
        static_cast<uint16_t>(command::register_ack),
        sizeof(ack)
    );
    
    std::vector<std::byte> data;
    data.resize(sizeof(header) + sizeof(ack));
    std::memcpy(data.data(), &header, sizeof(header));
    std::memcpy(data.data() + sizeof(header), &ack, sizeof(ack));
    
    RpcReceived recv_msg{
        .connection_id = 300,
        .data = std::move(data)
    };
    
    client.handle(protoflow::service::Message{std::move(recv_msg)});
    
    // Should transition to Registered state
    EXPECT_EQ(client.current_state(), State::Registered);
    EXPECT_TRUE(client.is_registered());
}

TEST_F(AppRegistrationClientProtocolTest, HandleRegisterAckWithFailureStatus) {
    AppRegistrationClient client(config);
    
    // Get to Registering state
    client.start();
    RpcConnected conn_msg{.connection_id = 400};
    client.handle(protoflow::service::Message{conn_msg});
    
    // Create REGISTER_ACK response with failure status
    register_ack ack{
        .app_id = 0,
        .status = 1  // Failure
    };
    
    auto header = protoflow::rpc::make_header(
        static_cast<uint16_t>(command::register_ack),
        sizeof(ack)
    );
    
    std::vector<std::byte> data;
    data.resize(sizeof(header) + sizeof(ack));
    std::memcpy(data.data(), &header, sizeof(header));
    std::memcpy(data.data() + sizeof(header), &ack, sizeof(ack));
    
    RpcReceived recv_msg{
        .connection_id = 400,
        .data = std::move(data)
    };
    
    client.handle(protoflow::service::Message{std::move(recv_msg)});
    
    // Should transition to Failed state
    EXPECT_EQ(client.current_state(), State::Failed);
    EXPECT_FALSE(client.is_registered());
}

TEST_F(AppRegistrationClientProtocolTest, HandleHeartbeatAckMessage) {
    AppRegistrationClient client(config);
    
    // Get to Registered state
    client.start();
    RpcConnected conn_msg{.connection_id = 500};
    client.handle(protoflow::service::Message{conn_msg});
    
    // Register successfully
    register_ack reg_ack{.app_id = 1, .status = 0};
    auto reg_header = protoflow::rpc::make_header(
        static_cast<uint16_t>(command::register_ack),
        sizeof(reg_ack)
    );
    std::vector<std::byte> reg_data;
    reg_data.resize(sizeof(reg_header) + sizeof(reg_ack));
    std::memcpy(reg_data.data(), &reg_header, sizeof(reg_header));
    std::memcpy(reg_data.data() + sizeof(reg_header), &reg_ack, sizeof(reg_ack));
    client.handle(protoflow::service::Message{RpcReceived{500, std::move(reg_data)}});
    
    EXPECT_EQ(client.current_state(), State::Registered);
    
    // Create HEARTBEAT_ACK response
    heartbeat_ack hb_ack{.timestamp = 12345};
    
    auto header = protoflow::rpc::make_header(
        static_cast<uint16_t>(command::heartbeat_ack),
        sizeof(hb_ack)
    );
    
    std::vector<std::byte> data;
    data.resize(sizeof(header) + sizeof(hb_ack));
    std::memcpy(data.data(), &header, sizeof(header));
    std::memcpy(data.data() + sizeof(header), &hb_ack, sizeof(hb_ack));
    
    RpcReceived recv_msg{
        .connection_id = 500,
        .data = std::move(data)
    };
    
    client.handle(protoflow::service::Message{std::move(recv_msg)});
    
    // Should stay in Registered state
    EXPECT_EQ(client.current_state(), State::Registered);
    EXPECT_TRUE(client.is_registered());
}

TEST_F(AppRegistrationClientProtocolTest, HandleErrorMessage) {
    AppRegistrationClient client(config);
    
    // Get to Registering state
    client.start();
    RpcConnected conn_msg{.connection_id = 600};
    client.handle(protoflow::service::Message{conn_msg});
    
    // Create ERROR message
    error_msg err{
        .error_code = 500
    };
    std::strncpy(err.message, "Internal server error", sizeof(err.message) - 1);
    
    auto header = protoflow::rpc::make_header(
        static_cast<uint16_t>(command::error),
        sizeof(err)
    );
    
    std::vector<std::byte> data;
    data.resize(sizeof(header) + sizeof(err));
    std::memcpy(data.data(), &header, sizeof(header));
    std::memcpy(data.data() + sizeof(header), &err, sizeof(err));
    
    RpcReceived recv_msg{
        .connection_id = 600,
        .data = std::move(data)
    };
    
    client.handle(protoflow::service::Message{std::move(recv_msg)});
    
    // Should transition to Failed state
    EXPECT_EQ(client.current_state(), State::Failed);
}

TEST_F(AppRegistrationClientProtocolTest, HandleInvalidRpcHeaderMagic) {
    AppRegistrationClient client(config);
    
    // Get to Registering state
    client.start();
    RpcConnected conn_msg{.connection_id = 700};
    client.handle(protoflow::service::Message{conn_msg});
    
    State before = client.current_state();
    
    // Create invalid RPC header
    protoflow::rpc::rpc_header bad_header{};
    bad_header.magic = 0xBADBAD;  // Invalid magic
    bad_header.version = 1;
    bad_header.cmd = 1;
    bad_header.payload_size = 0;
    
    std::vector<std::byte> data;
    data.resize(sizeof(bad_header));
    std::memcpy(data.data(), &bad_header, sizeof(bad_header));
    
    RpcReceived recv_msg{
        .connection_id = 700,
        .data = std::move(data)
    };
    
    client.handle(protoflow::service::Message{std::move(recv_msg)});
    
    // Should ignore invalid data and stay in same state
    EXPECT_EQ(client.current_state(), before);
}

TEST_F(AppRegistrationClientProtocolTest, HandleVersionMismatch) {
    AppRegistrationClient client(config);
    
    // Get to Registering state
    client.start();
    RpcConnected conn_msg{.connection_id = 800};
    client.handle(protoflow::service::Message{conn_msg});
    
    // Create HELLO_ACK with wrong version
    hello_ack ack{.version = 999};  // Wrong version
    
    auto header = protoflow::rpc::make_header(
        static_cast<uint16_t>(command::hello_ack),
        sizeof(ack)
    );
    
    std::vector<std::byte> data;
    data.resize(sizeof(header) + sizeof(ack));
    std::memcpy(data.data(), &header, sizeof(header));
    std::memcpy(data.data() + sizeof(header), &ack, sizeof(ack));
    
    RpcReceived recv_msg{
        .connection_id = 800,
        .data = std::move(data)
    };
    
    client.handle(protoflow::service::Message{std::move(recv_msg)});
    
    // Should transition to Failed due to version mismatch
    EXPECT_EQ(client.current_state(), State::Failed);
}

TEST_F(AppRegistrationClientProtocolTest, IgnoreDataFromWrongConnection) {
    AppRegistrationClient client(config);
    
    // Get to Registering state with connection 900
    client.start();
    RpcConnected conn_msg{.connection_id = 900};
    client.handle(protoflow::service::Message{conn_msg});
    
    State before = client.current_state();
    
    // Create data for wrong connection
    hello_ack ack{.version = 1};
    auto header = protoflow::rpc::make_header(
        static_cast<uint16_t>(command::hello_ack),
        sizeof(ack)
    );
    
    std::vector<std::byte> data;
    data.resize(sizeof(header) + sizeof(ack));
    std::memcpy(data.data(), &header, sizeof(header));
    std::memcpy(data.data() + sizeof(header), &ack, sizeof(ack));
    
    RpcReceived recv_msg{
        .connection_id = 999,  // Wrong connection ID
        .data = std::move(data)
    };
    
    client.handle(protoflow::service::Message{std::move(recv_msg)});
    
    // Should ignore and stay in same state
    EXPECT_EQ(client.current_state(), before);
}
